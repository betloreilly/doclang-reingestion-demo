# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored — never commit credentials.
#
# MinIO / S3-compatible object storage (read-only usage)
#
# Endpoint format (host:port, NO scheme):
#   MINIO_ENDPOINT=minio.example.com:9000
#   MINIO_ENDPOINT=127.0.0.1:9000
# Scheme is controlled by MINIO_SECURE (true = HTTPS with verified TLS).
#
# Example mc listing (replace with your alias / bucket / prefix):
#   mc ls myalias/your-bucket/docs/

MINIO_ENDPOINT=your-minio-host:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
# Optional temporary credentials:
MINIO_SESSION_TOKEN=
MINIO_SECURE=true
MINIO_BUCKET=your-bucket
MINIO_PREFIX=docs/

# Local paths (relative to backend/ unless absolute)
DATA_DIR=./data
CACHE_DIR=./data/cache
RUNS_DIR=./data/runs
ARTIFACTS_DIR=./data/artifacts
# Optional offline copies (mirror the remote prefix layout):
#   data/local/docs/dclx/*.dclx
#   data/local/docs/pdf/*.pdf
LOCAL_DOCS_DIR=./data/local

# CORS for the Next.js frontend
CORS_ORIGINS=http://localhost:3000

# Embedding model (local)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# FinanceBench recall comparison (DocLang vs Unstructured)
# The key is only read by the backend; it is never logged or sent to the browser.
OPENAI_API_KEY=your-openai-api-key
# Optional: OpenAI-compatible endpoint (leave empty for api.openai.com)
OPENAI_BASE_URL=
RECALL_EMBEDDING_MODEL=text-embedding-3-large
RECALL_EMBEDDING_PRICE_PER_MILLION=0.13
RECALL_DIR=./data/recall
# Python interpreter of the isolated Unstructured venv (see README)
UNSTRUCTURED_PYTHON=./.venv-unstructured/bin/python

# Local OpenSearch (docker compose at repo root — Rancher Desktop)
OPENSEARCH_URL=https://localhost:9200
OPENSEARCH_USER=admin
# Same value as OPENSEARCH_INITIAL_ADMIN_PASSWORD used for docker compose (do not commit real values)
OPENSEARCH_PASSWORD=
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_PREFIX=financebench-recall
RECALL_VECTOR_DIM=3072
